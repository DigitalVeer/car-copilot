+
+val FuelSystemSchematic: SchematicSpec = SchematicSpec(
+    viewport = Size(280f, 180f),
+    shapes = buildList {
+        // Tank — left side, a tall pillow-shape
+        add(
+            SchematicShape.RoundedRect(
