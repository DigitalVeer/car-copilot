+            labelAnchor = Offset(50f, 145f),
+        ),
+    ),
+    edgeLabels = listOf(
+        EdgeLabel("TANK", Offset(40f, 90f)),
+        EdgeLabel("HP PUMP", Offset(145f, 128f)),
+    ),
+)
